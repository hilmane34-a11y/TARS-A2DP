CONFIG_BT_ENABLED=y

CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# A2DP Audio Streaming Configuration
CONFIG_A2D_DYNAMIC_MEMORY=y
CONFIG_A2D_SBC_ENCODER_INCLUDED=y

# Memory optimized SBC configuration
CONFIG_BT_A2DP_SBC_ENCODER_TASK_STACK_SIZE=3000
CONFIG_A2DP_SBC_BUFFER_POOL_SIZE=12

# L2CAP Memory Optimization
CONFIG_BT_L2CAP_DEFALT_MTU=672
CONFIG_BT_L2CAP_TX_BUFFER_SIZE=3

# Bluetooth Controller Mode
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Bluetooth BR/EDR Memory
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=n

# Stack / Link Memory Optimization
CONFIG_BT_CLASSIC_QNUM_LINKS=1
CONFIG_BT_L2CAP_CHANNELS_NUM=4

# Reduce BLE overhead if using BR/EDR only
CONFIG_BT_BLE_ENABLED=n

# ============================================================
# ESP AUDIO CODEC - MP3 ONLY
# ============================================================

CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=n
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n

# HTTPS / TLS untuk TARS Cloud TTS
CONFIG_MBEDTLS_SSL_ALPN=y

# Certificate Bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=n

# Aktifkan certificate bundle untuk HTTPS client
CONFIG_ESP_TLS_USE_SECURE_ELEMENT=n

# ============================================================
# MEMORY OPTIMIZATION
# ============================================================

# Reduce Bluetooth controller DRAM (sudah disable BLE)
CONFIG_BT_RESERVE_DRAM=0

# Disable task watchdog during long operations
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Optimize for speed vs size (balance)
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=n

# Custom partition TARS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/TARS_ESP32_A2DP/partitions.csv"

# Memory Management
CONFIG_SPIRAM=n
